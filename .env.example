# MeldDB control plane
DATABASE_URL=
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY_VERSION=1

# Optional explicit auth/app configuration.
# On Vercel, URLs are inferred automatically from system environment variables.
# BETTER_AUTH_SECRET is optional; when omitted it is derived from CREDENTIAL_ENCRYPTION_KEY with key separation.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
APP_URL=

# Optional email delivery for secure password reset
RESEND_API_KEY=
EMAIL_FROM=

# Supabase OAuth Management API application
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
SUPABASE_OAUTH_REDIRECT_URI=

# Cloudflare OAuth application
CLOUDFLARE_OAUTH_CLIENT_ID=
CLOUDFLARE_OAUTH_CLIENT_SECRET=
CLOUDFLARE_OAUTH_REDIRECT_URI=

# Optional operational controls
QUERY_LOG_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=90
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
